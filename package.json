{
  "name": "printfold",
  "version": "1.0.0",
  "description": "Create printable, signature-based booklets from markdown documents",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build:web": "webpack --mode production --config webpack.web.config.js",
    "build:electron": "webpack --mode production --config webpack.electron.config.js",
    "build:electron-main": "webpack --mode development --config webpack.electron.config.js",
    "electron:dev": "npm run build:electron-main && concurrently \"ELECTRON_DEV=true webpack serve --mode development\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build:electron && electron-builder",
    "start": "electron .",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "booklet",
    "markdown",
    "pdf",
    "printing",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/three": "^0.182.0",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "html-webpack-plugin": "^5.5.4",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.2",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "dependencies": {
    "@codemirror/commands": "^6.3.2",
    "@codemirror/lang-markdown": "^6.2.3",
    "@codemirror/state": "^6.3.3",
    "@codemirror/view": "^6.22.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "codemirror": "^6.0.1",
    "google-fonts-helper": "^3.7.3",
    "jszip": "^3.10.1",
    "konva": "^9.2.3",
    "marked": "^11.1.0",
    "pdf-lib": "^1.17.1",
    "three": "^0.160.0"
  },
  "build": {
    "appId": "com.printfold.app",
    "productName": "PrintFold",
    "files": [
      "dist/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
